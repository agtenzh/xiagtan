# 环境变量配置

# OpenAI配置
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4

# Anthropic配置（可选）
ANTHROPIC_API_KEY=your-anthropic-api-key

# 本地模型配置（可选）
OLLAMA_BASE_URL=http://localhost:11434

# 数据库配置
DATABASE_URL=sqlite:///./data/agency.db

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# 日志配置
LOG_LEVEL=INFO
