# Agency AI System Configuration
APP_NAME=Agency AI System
APP_VERSION=0.1.0
DEBUG=False

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration
DATABASE_URL=sqlite:///./data/agency.db
# For PostgreSQL use:
# DATABASE_URL=postgresql://user:password@localhost/agency_db

# Queue Configuration
QUEUE_TYPE=memory
# For RabbitMQ use:
# QUEUE_TYPE=rabbitmq
# RABBITMQ_URL=amqp://user:password@localhost:5672/

# Cache Configuration
CACHE_TYPE=memory
# For Redis use:
# CACHE_TYPE=redis
# REDIS_URL=redis://localhost:6379/0

# Performance Configuration
MAX_AGENTS=10
MAX_CONCURRENT_TASKS=5

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security Configuration
SECRET_KEY=your-secret-key-change-in-production-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Model Providers (Optional)
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
